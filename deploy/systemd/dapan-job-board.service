[Unit]
Description=Dapan Job Board Docker Compose
Requires=docker.service
Wants=dapan-job-board-direct-routing.service
After=docker.service network-online.target dapan-job-board-direct-routing.service

[Service]
Type=oneshot
RemainAfterExit=yes
User=zhihongpan
Group=zhihongpan
SupplementaryGroups=docker
WorkingDirectory=/home/zhihongpan/services/dapan-job-board
ExecStart=/usr/bin/docker compose -f compose.yaml -f compose.wsl.yaml up -d --no-build
ExecStop=/usr/bin/docker compose -f compose.yaml -f compose.wsl.yaml stop
TimeoutStartSec=180
TimeoutStopSec=90

[Install]
WantedBy=multi-user.target
