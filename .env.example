# Public URL and allowed browser origins
APP_ORIGIN=https://example.com
APP_ORIGINS=http://YOUR_SERVER_IP
KDOCS_SOURCE_URL=https://www.kdocs.cn/l/REPLACE_ME

# Optional fixed initial password: add ADMIN_PASSWORD to your private .env.
# Omit it to generate a random password on first startup.

# Company review provider
REVIEW_MODE=openai-web-search
OPENAI_API_KEY=replace-me
OPENAI_BASE_URL=https://api.example.com/v1
OPENAI_MODEL=replace-me
OPENAI_PROVIDER_NAME=OpenAI-compatible web search
OPENAI_WEB_SEARCH_TOOL=web_search
OPENAI_REASONING_EFFORT=low
OPENAI_MAX_OUTPUT_TOKENS=2000

# Presentation recording transcription and summary
ASR_DASHSCOPE_API_KEY=replace-me
ASR_MODEL=qwen-audio-3.0-asr-flash-filetrans
ASR_PUBLIC_ORIGIN=http://YOUR_SERVER_IP
MAX_AUDIO_UPLOAD_MB=500

# PushPlus notifications
PUSHPLUS_TOKEN=replace-me
# PUSHPLUS_BASE_URL=https://www.pushplus.plus/send
